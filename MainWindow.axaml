<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="InventarioVideojuegosDilanTapia.MainWindow"
        Title="Inventario de Videojuegos | Dilan Tapia Mercado"
        Width="1160" Height="780" MinWidth="950" MinHeight="680"
        Background="#F3F6FC">
  <Window.Styles>
    <Style Selector="Button">
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="37" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,*,Auto" Margin="22" RowSpacing="15">
    <Border Background="#162447" CornerRadius="12" Padding="22">
      <StackPanel Spacing="5">
        <TextBlock Text="INVENTARIO DE VIDEOJUEGOS" FontSize="25" FontWeight="Bold" Foreground="White" />
        <TextBlock Text="Registro, consulta, edición y eliminación | Dilan Tapia Mercado" Foreground="#CFDAF5" FontSize="13" />
      </StackPanel>
    </Border>
    <Grid Grid.Row="1" ColumnDefinitions="345,*" ColumnSpacing="16">
      <Border Background="White" CornerRadius="12" Padding="18">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="6">
            <TextBlock Text="Datos del videojuego" FontSize="19" FontWeight="SemiBold" />
            <TextBlock x:Name="IdTexto" Text="Nuevo registro" Foreground="#54617A" />
            <TextBlock Text="Nombre" FontWeight="SemiBold" />
            <TextBox x:Name="NombreCaja" Watermark="Ej.: Hollow Knight" />
            <TextBlock Text="Género" FontWeight="SemiBold" />
            <TextBox x:Name="GeneroCaja" Watermark="Ej.: Aventura" />
            <TextBlock Text="Plataforma" FontWeight="SemiBold" />
            <TextBox x:Name="PlataformaCaja" Watermark="Ej.: PC" />
            <TextBlock Text="Precio (COP)" FontWeight="SemiBold" />
            <TextBox x:Name="PrecioCaja" Watermark="Ej.: 59900" />
            <TextBlock Text="Cantidad disponible" FontWeight="SemiBold" />
            <TextBox x:Name="CantidadCaja" Watermark="Ej.: 10" />
            <Button x:Name="GuardarBoton" Content="Registrar videojuego" Background="#2563EB" Foreground="White" Click="Guardar_Click" Margin="0,10,0,0" />
            <Button Content="Limpiar formulario" Background="#E2E8F0" Foreground="#172447" Click="Limpiar_Click" />
            <Button Content="Eliminar seleccionado" Background="#B42318" Foreground="White" Click="Eliminar_Click" />
            <TextBlock Text="Selecciona una fila para editarla o eliminarla." TextWrapping="Wrap" Foreground="#64748B" FontSize="12" />
          </StackPanel>
        </ScrollViewer>
      </Border>
      <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="16">
        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
          <TextBlock Text="Videojuegos registrados" FontSize="19" FontWeight="SemiBold" />
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox x:Name="BuscarCaja" Watermark="Buscar por nombre, género o plataforma" TextChanged="Buscar_TextChanged" />
            <Button Grid.Column="1" Content="Actualizar lista" Click="Actualizar_Click" />
          </Grid>
          <DataGrid x:Name="TablaVideojuegos" Grid.Row="2" AutoGenerateColumns="False"
                    IsReadOnly="True" SelectionMode="Single" GridLinesVisibility="All" Background="White" Foreground="#172447"
                    SelectionChanged="Tabla_SelectionChanged">
            <DataGrid.Columns>
              <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="45" />
              <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*" />
              <DataGridTextColumn Header="Género" Binding="{Binding Genero}" Width="95" />
              <DataGridTextColumn Header="Plataforma" Binding="{Binding Plataforma}" Width="95" />
              <DataGridTextColumn Header="Precio" Binding="{Binding Precio}" Width="90" />
              <DataGridTextColumn Header="Stock" Binding="{Binding Cantidad}" Width="60" />
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock x:Name="TotalTexto" Grid.Row="3" Foreground="#475569" />
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Row="2" Background="#E2E8F0" CornerRadius="8" Padding="12">
      <TextBlock x:Name="EstadoTexto" Text="Listo para administrar tus videojuegos." TextWrapping="Wrap" Foreground="#0F172A" />
    </Border>
  </Grid>
</Window>
